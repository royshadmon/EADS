          "datasource": {
            "type": "simpod-json-datasource",
            "uid": "anylog-query"
          },
          "refId": "A",
          "target": "voltage_calibrated",
          "type": "timeseries",
          "payload": "{\"dbms\": \"eads\", \"type\": \"increments\", \"time_column\": \"insert_timestamp\", \"value_column\": \"is_anomaly\", \"grafana\": {\"format_as\": \"timeseries\", \"data_points\": 500}}"
        }
      ],
      "description": "1 = sample inside a detected anomaly window."
    },
