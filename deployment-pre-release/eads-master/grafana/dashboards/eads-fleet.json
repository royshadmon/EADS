  "templating": {
    "list": [
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "dfz3c2qymqyo0e"
        },
        "query": "SELECT DISTINCT node_id AS __text, data->>'tsd_name' AS __value FROM (SELECT node_id, data FROM eads_archive.node_health ORDER BY archived_at DESC LIMIT 200) t ORDER BY 1",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Anomalies",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "dfz3c2qymqyo0e"
        },
        "target": {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_timestamp(min(ts_us)/1000000.0) AS time, node_id AS text, data->>'anomaly_id' AS tags FROM eads_archive.voltage_calibrated WHERE $__timeFilter(to_timestamp(ts_us/1000000.0)) GROUP BY node_id, data->>'anomaly_id' ORDER BY 1"
        }
      }
    ]
  }
