      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${operator_ds}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(AVG(voltage), 0)  AS avg_voltage,\n  COALESCE(AVG(current), 0)  AS avg_current,\n  COALESCE(AVG(power), 0)    AS avg_power,\n  COALESCE(AVG(frequency), 0) AS avg_frequency,\n  COALESCE(100.0 * AVG(CASE WHEN anomaly_label <> 0 THEN 1 ELSE 0 END), 0) AS anomaly_rate\nFROM grid_readings\nWHERE timestamp >= now() - interval '1 hour'\n  AND ('${sensor:regex}' = '.*' OR sensor_id ~ '${sensor:regex}')\n  AND ('${location:regex}' = '.*' OR location ~ '${location:regex}')\n  AND ('${anomaly:regex}' = '.*' OR anomaly_label::text ~ '${anomaly:regex}')",
          "refId": "A"
        }
      ],
      "title": "KPI Summary (last hour)",
      "type": "stat"
    },
