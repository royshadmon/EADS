# Grafana Admin Credentials
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# Grafana Port
GRAFANA_PORT=3000

# AnyLog Connection
# Use 'host.docker.internal' when Grafana runs in Docker and AnyLog runs on the host
# Use '127.0.0.1' when both run on the host directly
ANYLOG_HOST=host.docker.internal
ANYLOG_REST_PORT=32149
